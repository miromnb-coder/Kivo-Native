{
  "name": "kivo-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "tunnel": "expo start --tunnel",
    "tunnel:clear": "expo start --tunnel --clear",
    "tunnel:8081": "expo start --tunnel --clear --port 8081",
    "tunnel:8082": "expo start --tunnel --clear --port 8082",
    "tunnel:8083": "expo start --tunnel --clear --port 8083",
    "tunnel:8084": "expo start --tunnel --clear --port 8084",
    "tunnel:8085": "expo start --tunnel --clear --port 8085",
    "tunnel:8086": "expo start --tunnel --clear --port 8086",
    "dev:stop": "pkill -f 'expo start' || true; pkill -f '@expo/ngrok' || true; pkill -f 'ngrok' || true",
    "phone": "npm run tunnel:8083",
    "phone:fallback": "npm run dev:stop && npm run tunnel:8084",
    "phone:fallback2": "npm run dev:stop && npm run tunnel:8085",
    "phone:fallback3": "npm run dev:stop && npm run tunnel:8086",
    "install:safe": "npm i --legacy-peer-deps",
    "install:web": "npx expo install react-native-web react-dom @expo/metro-runtime",
    "install:supabase": "npx expo install @supabase/supabase-js @react-native-async-storage/async-storage react-native-url-polyfill",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.0",
    "expo-media-library": "~18.2.0",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
